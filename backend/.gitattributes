# Normalize all text files to LF in the repo, regardless of each
# developer's local core.autocrlf setting. This is what stops every
# file from showing as "modified" after a clone/checkout on a
# different OS/editor config.
* text=auto eol=lf

*.java text eol=lf
*.jsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Keep existing Windows-specific rules
/gradlew text eol=lf
*.bat    text eol=crlf
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary